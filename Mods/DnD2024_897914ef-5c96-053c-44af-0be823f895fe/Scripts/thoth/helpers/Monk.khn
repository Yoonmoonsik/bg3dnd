function ConvertingSpellSlotsToFocusPoints()
	return SpellId('Shout_ConvertingSpellSlotsToFocusPoints')
	| SpellId('Shout_ConvertingSpellSlotsToFocusPoints_1')
	| SpellId('Shout_ConvertingSpellSlotsToFocusPoints_2')
	| SpellId('Shout_ConvertingSpellSlotsToFocusPoints_3')
	| SpellId('Shout_ConvertingSpellSlotsToFocusPoints_4')
end