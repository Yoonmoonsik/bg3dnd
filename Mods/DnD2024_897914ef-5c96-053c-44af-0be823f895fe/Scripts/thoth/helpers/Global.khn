function Blooded(entity)
    entity = entity or context.Target
    return ConditionResult(entity.HPPercentageWithoutTemporaryHP < 50)
end

function StrAttackSaveDC()
    return 8 + context.Source.ProficiencyBonus + GetModifier(context.Source.Strength)
end

function IntAttackSaveDC()
    return 8 + context.Source.ProficiencyBonus + GetModifier(context.Source.Intelligence)
end

function WisAttackSaveDC()
    return 8 + context.Source.ProficiencyBonus + GetModifier(context.Source.Wisdom)
end

function ChaAttackSaveDC()
    return 8 + context.Source.ProficiencyBonus + GetModifier(context.Source.Charisma)
end

function MeleeUnarmed(entity)
    -- Default to Target, like cpp functions
    entity = entity or context.Target
    return ~WieldingWeapon('Melee', false, true, entity)
end

function GreatWeaponMaster(entity)
    local entity = entity or context.Source
    local weapon = context.AttackWeapon

    local isHeavy = HasWeaponProperty(WeaponProperties.Heavy, weapon)
    local isTwoHanded = HasWeaponProperty(WeaponProperties.Twohanded, weapon)
    local isVersatile = HasWeaponProperty(WeaponProperties.Versatile, weapon)
    local isOffhandMelee = WieldingWeapon('Melee', true, false, entity)
    local isOffhandAmmunition = WieldingWeapon('Ammunition', true, false, entity)
    local hasShield = HasShieldEquipped(entity)

    return IsProficientWith(entity, weapon) & ((isTwoHanded) | (isVersatile & ~isOffhandMelee & ~isOffhandAmmunition & ~hasShield))
end

function FightingStyle_GreatWeapon(entity)
    -- Default to Target, like cpp functions
    entity = entity or context.Target
    local hasTwohandedWeapon = WieldingWeapon('Twohanded', false, false, entity)
    local hasVersatileWeapon = WieldingWeapon('Versatile', false, false, entity) & ~WieldingWeapon('Melee', true, false, entity) & ~WieldingWeapon('Ammunition', true, false, entity) & ~HasShieldEquipped(entity)
    return hasTwohandedWeapon | hasVersatileWeapon
end

function PoisonerSaveDC()
    return 8 + context.Source.ProficiencyBonus + math.max(GetModifier(context.Source.Dexterity), GetModifier(context.Source.Intelligence))
end

function StrConSaveDC()
    return 8 + context.Source.ProficiencyBonus + math.max(GetModifier(context.Source.Strength), GetModifier(context.Source.Constitution))
end

function StrWisSaveDC()
    return 8 + context.Source.ProficiencyBonus + math.max(GetModifier(context.Source.Strength), GetModifier(context.Source.Wisdom))
end

function WisChaSaveDC()
    return 8 + context.Source.ProficiencyBonus + math.max(GetModifier(context.Source.Wisdom), GetModifier(context.Source.Charisma))
end

function YDistanceToTargetSmallerOrEqual(value)
    local errorTrue = {ConditionError("YDistanceGreaterOrEqualThan_True", {ConditionErrorData.MakeFromNumber(value, EErrorDataType.Distance)})}
    local errorFalse = {ConditionError("YDistanceGreaterOrEqualThan_False", {ConditionErrorData.MakeFromNumber(value, EErrorDataType.Distance)})}
    return ConditionResult(YDistanceToTarget() <= value, errorTrue, errorFalse)
end

function IsStrengthModifierPositive()
    return GetModifier(context.Source.Strength) > 0
end

function IsDisengageAction()
    return SpellId('Shout_Disengage')
    | SpellId('Shout_Disengage_BonusAction')
    | SpellId('Shout_Disengage_BonusAction_Temp')
    | SpellId('Shout_Disengage_BonusAction_Monk')
    | SpellId('Shout_Disengage_CunningAction')
    | SpellId('Shout_Disengage_Goblin')
    | SpellId('Shout_Disengage_Haste')
    | SpellId('Shout_Disengage_Reaction_Temp')
    | SpellId('Shout_Disengage_StepOfTheWind')
    | SpellId('Shout_GOB_WolfPens_Disengage_GoblinKid')
    | SpellId('Shout_LOW_Dolor_Disengage')
    | SpellId('Shout_Totem_Eagle_Disengage_BonusAction')
    | SpellId('Shout_StepOfTheWind')
    | SpellId('Shout_PatientDefense')
    | SpellId('Shout_Dash_BonusAction_SavageCharge')
    | SpellId('Shout_InspiringMovement')
    | SpellId('Shout_ShadowStealth_Meazel')
    | SpellId('Shout_AshardalonsStride')
    | SpellId('Shout_AshardalonsStride_4')
    | SpellId('Shout_AshardalonsStride_5')
    | SpellId('Shout_AshardalonsStride_6')
    | SpellId('Shout_AshardalonsStride_spellscroll')
    | SpellId('Shout_SuddenRush_Gnoll')
    | SpellId('Target_DrunkenTechnique')
    | SpellId('Target_RecklessAttackForcefulBlow')
    | SpellId('Target_RecklessAttackForcefulBlow_Unarmed')
end

function SanguinePoppetACBonusAtLeast(value)
    local summoner = GetSummoner(context.Source)
    local bonus = summoner.ProficiencyBonus + math.max(GetModifier(summoner.Intelligence), GetModifier(summoner.Wisdom), GetModifier(summoner.Charisma))
    return ConditionResult(bonus >= value)
end

