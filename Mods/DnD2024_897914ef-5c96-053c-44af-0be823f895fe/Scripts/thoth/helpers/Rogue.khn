function SanctifiedChampion(entity, mainHand)
    local entity = entity or context.Source
    local weaponEntity = GetActiveWeapon(entity, true)
    if weaponEntity.IsValid then
        result = Character(entity) & HasStatus('SANCTIFIED_CHAMPION', weaponEntity)
        return ConditionResult(result.Result, {ConditionError("HasNotPactWeapon")}, {ConditionError("HasPactWeapon")})
    end
    return ConditionResult(false, {ConditionError("HasNotPactWeapon")}, {ConditionError("HasPactWeapon")})
end

function DexterityGreaterThanStrength(entity)
    entity = entity or context.Source
    return ConditionResult(GetModifier(entity.Dexterity) > GetModifier(entity.Strength))
end

function IsThrownWeaponAttack()
    local res = SpellTypeIs(SpellType.Throw) & HasWeaponProperty(WeaponProperties.Thrown, context.HitDescription.ThrownObject) & HasWeaponProperty(WeaponProperties.Light, context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end