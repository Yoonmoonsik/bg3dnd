function IllriggerSeal()
    return SpellId('Target_Seal')
    | SpellId('Target_BurningSeals_Fire')
    | SpellId('Target_BurningSeals_Necrotic')
    | SpellId('Target_UnleashHell_Fire')
    | SpellId('Target_UnleashHell_Necrotic')
end

function InfernalConduit()
    return SpellId('Target_InfernalConduit_Devour')
    | SpellId('Target_InfernalConduit_Invigorate')
end

function RedCantCheck(entity)
    local entity = entity or context.Source
    local isAbility = context.CheckedAbility == Ability.Charisma
    local isSkill1 = context.CheckedSkill == Skill.Deception
    local isSkill2 = context.CheckedSkill == Skill.Intimidation
    local isSkill3 = context.CheckedSkill == Skill.Performance
    local isSkill4 = context.CheckedSkill == Skill.Persuasion
    return ConditionResult(isAbility or isSkill1 or isSkill2 or isSkill3 or isSkill4)
end

function HellsLashSavingThrow()
    local hellsLashDC = math.max(
        SourceSpellDC(10, context.Source, Ability.Intelligence),
        SourceSpellDC(10, context.Source, Ability.Wisdom),
        SourceSpellDC(10, context.Source, Ability.Charisma))
    local st = SavingThrow(Ability.Constitution, hellsLashDC, false, HasStatus('INTERDICTED', context.Target) | DisadvantageOnHeightenedSpell(), context.Target)
    return ConditionResult(st.Result,{},{},st.Chance)
end
